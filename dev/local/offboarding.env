# offboarding from the IDE, the rest of the stack in Docker (see memes.env for the idea).
OFFBOARDING_PROFILE=dev
OFFBOARDING_PORT=8094
OFFBOARDING_PARTICIPANTS=memes=memes-events,comments=comments-events,collections=usercollections-events
DB_URL=jdbc:postgresql://localhost:5437/offboarding
DB_USER=postgres
DB_PASSWORD=secret
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
