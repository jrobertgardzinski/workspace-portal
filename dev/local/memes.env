# memes from the IDE, the rest of the stack in Docker: the compose wiring seen from the host.
# Same variable names as docker-compose.yml, so nothing in the service knows the difference.
SPRING_PROFILES_ACTIVE=dev
SECURITY_URL=http://localhost:8080
DB_URL=jdbc:postgresql://localhost:5434/memes
DB_USER=postgres
DB_PASSWORD=secret
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_ENABLED=true
IMAGE_ENCODER_URL=http://localhost:8087
MEMES_BLOB_STORE=s3
MEMES_S3_ENDPOINT=http://localhost:9000
MEMES_S3_BUCKET=memes
MEMES_S3_ACCESS_KEY=memes
MEMES_S3_SECRET_KEY=supersecret
