<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.jrobertgardzinski</groupId>
        <artifactId>microservice-memes</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>memes-ui</artifactId>

    <!--
      The gallery UI: React + TypeScript + Material UI, built by Vite. The Maven build runs npm
      through frontend-maven-plugin (own pinned Node, no host toolchain needed) and packs the dist
      into META-INF/resources — memes-infrastructure depends on this jar, so Spring Boot serves the
      UI from the classpath. For UI development: cd memes-ui && npm run dev (proxies /memes to
      localhost:8083).
    -->
    <properties>
        <!-- v22.12.0 until 2026-07-28, bumped because jsdom (the unit suite's DOM) declares
             ^22.13.0 and npm was only warning about it — a build that runs on an engine its own
             dependency says it does not support is a silent breakage waiting for a bad day.
             Same LTS line, so nothing else about the build changes. -->
        <node.version>v22.23.1</node.version>
        <!-- declared so -DskipTests can override it: frontend-maven-plugin has no notion of the
             surefire switch, so the vitest execution below reads this property by hand. Without a
             default here the expression would reach the plugin unresolved. -->
        <skipTests>false</skipTests>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>2.0.2</version>
                <configuration>
                    <nodeVersion>${node.version}</nodeVersion>
                    <installDirectory>target</installDirectory>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals><goal>install-node-and-npm</goal></goals>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals><goal>npm</goal></goals>
                        <configuration><arguments>install</arguments></configuration>
                    </execution>
                    <execution>
                        <id>npm-build</id>
                        <goals><goal>npm</goal></goals>
                        <phase>generate-resources</phase>
                        <configuration><arguments>run build</arguments></configuration>
                    </execution>
                    <!--
                      The UI's unit suite (vitest + Testing Library), in the `test` phase like any
                      other module's. It covers the states e2e/ cannot hold still: e2e drives a real
                      stack, so anything that exists only BETWEEN two events races the broker there.
                      The favourites keepsake is the case that forced this — see App.test.tsx.
                    -->
                    <execution>
                        <id>npm-test</id>
                        <goals><goal>npm</goal></goals>
                        <phase>test</phase>
                        <configuration>
                            <arguments>test</arguments>
                            <skip>${skipTests}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>pack-dist-as-webjar</id>
                        <phase>process-resources</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF/resources</outputDirectory>
                            <resources>
                                <resource><directory>dist</directory></resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
