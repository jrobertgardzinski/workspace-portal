<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.jrobertgardzinski</groupId>
    <artifactId>microservice-memes</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <!--
      A meme service: upload images, optimise them for the browser, comment, vote. A more
      monolithic build than the split libs of microservice-security, but still layered into small
      modules. Framework: Spring Boot (the third flavour after Micronaut/security and Quarkus/email).
    -->
    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.2</spring-boot.version>
        <!-- Spring Boot 4's BOM no longer manages these two; pinned so the build stays
             reproducible rather than resolving whatever happens to be newest. -->
        <rest-assured.version>6.0.1</rest-assured.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <allure.version>2.35.5</allure.version>
        <cucumber.version>7.34.8</cucumber.version>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
    </properties>

    <modules>
        <module>memes-domain</module>
        <module>memes-config</module>
        <module>memes-image</module>
        <module>memes-tags</module>
        <module>memes-system</module>
        <module>memes-application</module>
        <module>memes_account-closure</module>
        <module>memes-ui</module>
        <module>memes-infrastructure</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.cucumber</groupId>
                <artifactId>cucumber-bom</artifactId>
                <version>${cucumber.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- the family's own modules: one version, the reactor's -->
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>memes-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>memes-config</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>memes-tags</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>memes-image</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>memes-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>memes_account-closure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>memes-ui</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- foreign artifacts pinned explicitly -->
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>voting</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>observation</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <!-- the promise the mark and its confirmation commit together -->
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>unit-of-work</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <!-- the words this service shares with identity and the orchestrator when an account
                 closes: the command names and who asked for the closure -->
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>account-closure</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>offline-jwt</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>user-id</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>author-directory</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <!-- the shared transactional outbox: this service's own implementation (rounds 5-9)
                 was the one it was extracted from, so the guarantee is the same code now, not a
                 same-shaped copy — see the kernel's transactional-outbox/README.md -->
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>transactional-outbox</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>com.jrobertgardzinski</groupId>
                <artifactId>infrastructure-spring-outbox</artifactId>
                <version>1.0.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>s3</artifactId>
                <version>2.50.0</version>
            </dependency>
            <dependency>
                <groupId>au.com.dius.pact.consumer</groupId>
                <artifactId>junit5</artifactId>
                <version>4.7.6</version>
            </dependency>
            <dependency>
                <groupId>au.com.dius.pact.provider</groupId>
                <artifactId>junit5</artifactId>
                <version>4.7.6</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Inherited by every module: Allure reports for all JUnit 5 tests. -->
    <dependencies>
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler-plugin.version}</version>
                    <configuration>
                        <!-- Spring needs parameter names (e.g. @PathVariable) at runtime. -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire-plugin.version}</version>
                    <configuration>
                        <systemPropertyVariables>
                            <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <!-- allure reports everywhere -->
                <plugin>
                    <groupId>io.qameta.allure</groupId>
                    <artifactId>allure-maven</artifactId>
                    <version>3.1.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
