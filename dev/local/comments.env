# comments from the IDE, the rest of the stack in Docker (see memes.env for the idea).
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5435/comments
DB_USER=postgres
DB_PASSWORD=secret
SECURITY_URL=http://localhost:8080
SECURITY_VERIFY=offline
MEMES_URL=http://localhost:8083
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_ENABLED=true
